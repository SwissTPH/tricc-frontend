{
  "name": "@tricc/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lang": {
      "types": "./dist/lang/index.d.ts",
      "import": "./dist/lang/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lang:check": "node ../../scripts/sync-lang.mjs --check && node ../../scripts/generate-lang-parsers.mjs --check"
  },
  "dependencies": {
    "antlr4": "4.13.2",
    "fflate": "^0.8.2",
    "linkedom": "^0.18.12",
    "markdown-it": "^14.1.0",
    "prosemirror-model": "^1.25.4",
    "yaml": "^2.6.1",
    "yjs": "^13.6.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
