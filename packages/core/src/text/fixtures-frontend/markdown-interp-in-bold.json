{
  "name": "markdown-interp-in-bold",
  "input": {
    "markdown": "**Give ${dose} mg**"
  },
  "doc": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Give ",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "interp",
            "attrs": {
              "name": "dose"
            },
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " mg",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      }
    ]
  },
  "plain": "Give … mg",
  "markdown": "**Give ${dose} mg**",
  "xhtml": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><strong>Give … mg</strong></p></div>"
}
